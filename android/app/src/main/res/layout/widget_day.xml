<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:padding="3dp" android:background="@drawable/widget_badge" android:src="@drawable/ic_widget_barbell" android:tint="@color/widget_on_accent" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="FORMA · Dziś" android:textColor="@color/widget_day_muted" android:textStyle="bold" android:textSize="12sp" android:maxLines="1"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="78dp" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp">
    <ImageView android:id="@+id/widget_ring" android:layout_width="78dp" android:layout_height="78dp" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
      <TextView android:id="@+id/widget_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/widget_day_ink" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textSize="30sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"/>
      <TextView android:id="@+id/widget_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_day_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="4dp">
      <ProgressBar android:id="@+id/widget_protein_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progressDrawable="@drawable/widget_progress_protein"/>
      <TextView android:id="@+id/widget_protein" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Białko" android:textColor="@color/widget_day_muted" android:textSize="10sp" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="4dp">
      <ProgressBar android:id="@+id/widget_fat_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progressDrawable="@drawable/widget_progress_fat"/>
      <TextView android:id="@+id/widget_fat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Tłuszcz" android:textColor="@color/widget_day_muted" android:textSize="10sp" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <ProgressBar android:id="@+id/widget_carbs_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progressDrawable="@drawable/widget_progress_carbs"/>
      <TextView android:id="@+id/widget_carbs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Węgle" android:textColor="@color/widget_day_muted" android:textSize="10sp" android:maxLines="1"/>
    </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_button" android:paddingStart="16dp" android:paddingEnd="6dp">
    <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Twój trening" android:textColor="@color/widget_day_ink" android:textStyle="bold" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
    <Chronometer android:id="@+id/widget_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_day_ink" android:textStyle="bold" android:textSize="17sp" android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:visibility="gone"/>
    <ImageView android:id="@+id/widget_toggle" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:background="@drawable/widget_pill_accent" android:src="@drawable/ic_widget_play" android:tint="@color/widget_on_accent" android:contentDescription="Trening"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:layout_marginTop="8dp">
    <TextView android:id="@+id/widget_food" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_button" android:gravity="center" android:drawableStart="@drawable/ic_widget_plus" android:drawableTint="@color/widget_day_accent" android:drawablePadding="4dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Jedzenie" android:textColor="@color/widget_day_ink" android:textStyle="bold" android:textSize="13sp"/>
    <TextView android:id="@+id/widget_training" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:gravity="center" android:drawableStart="@drawable/ic_widget_chart" android:drawableTint="@color/widget_day_accent" android:drawablePadding="4dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Postępy" android:textColor="@color/widget_day_ink" android:textStyle="bold" android:textSize="13sp"/>
  </LinearLayout>
</LinearLayout>
